#!/usr/bin/env bash

# pings Hetzner datacenter locations in parallel and prints stats sorted by average latency

(
  printf "LOCATION MIN AVG MAX STDDEV\n"
  for dc in sin nbg1 fsn1 hel1 ash hil; do
    {
      stats=$(ping -i .1 -c 10 -q "${dc}-speed.hetzner.com" 2>/dev/null | awk -F"[ /=]+" '/^(round|rtt)/ {print $6, $7, $8, $9}')
      printf "%s %s\n" "$dc" "${stats:-- - - -}"
    } &
  done
  wait
) | sort -n -k3 | column -t


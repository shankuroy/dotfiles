# zshrc

# Internal helper to validate dependencies before sourcing or execution.
# Usage: _require [ -c|--command | -f|--file | -d|--directory | -x|--executable ] <target>
_require() {
  local opt=$1 target=$2
  local req_name trace="${funcfiletrace[1]##*/}"

  if (( $# != 2 )); then
    print -P "%F{red}[ERROR][$trace]:%f Usage: _require [ -c|--command | -f|--file | -d|--directory | -x|--executable ] <target>" >&2
    return 1
  fi

  case "$opt" in
    -c|--command)    req_name="command"   ; (( ${+commands[$target]} )) ;;
    -f|--file)       req_name="file"      ; [[ -f "$target" ]] ;;
    -d|--directory)  req_name="directory" ; [[ -d "$target" ]] ;;
    -x|--executable) req_name="executable"; [[ -x "$target" ]] ;;
    *)
      print -P "%F{red}[ERROR][$trace]:%f unknown flag: %U$opt%u" >&2
      return 1
      ;;
  esac

  if (( $? != 0 )); then
    print -P "%F{red}[WARN][$trace]:%f missing $req_name: %B$target%b" >&2
    return 1
  fi

  return 0
}

typeset -U fpath      # deduplicate fpath entries automatically
typeset -U path       # ensure PATH only contains unique entries
                      #   append dirs with: path=($path "/path/to/dir1" "/path/to/dir2")

# homebrew site functions
_require -c brew \
  && BREW_PREFIX="$(brew --prefix 2>/dev/null)" \
  && () {
    local brew_sitefuncs="$BREW_PREFIX/share/zsh/site-functions"
    _require -d "$brew_sitefuncs" && fpath+=("$brew_sitefuncs")
  }

# prompt init
autoload -U promptinit
promptinit

# lazy-loaded completion system
autoload -U compinit add-zsh-hook
_compinit_once() {
  compinit
  unfunction _compinit_once
}
add-zsh-hook precmd _compinit_once
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' # case-insensitive completions

# zsh syntax highlighting
ZSH_SYNTAX_HL_FILE="${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
_require -f "${ZSH_SYNTAX_HL_FILE}" && . "${ZSH_SYNTAX_HL_FILE}"

# zsh auto-suggestions
ZSH_AUTOSUGGESTIONS_FILE="${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
_require -f "${ZSH_AUTOSUGGESTIONS_FILE}" && . "${ZSH_AUTOSUGGESTIONS_FILE}"

# zsh history
setopt SHARE_HISTORY                 # shared history between terminals
setopt HIST_IGNORE_ALL_DUPS          # no duplicates in the history
export HISTFILE=${HOME}/.zsh_history # history file location
export HISTSIZE=100000               # history items in memory
export SAVEHIST="${HISTSIZE}"        # history items saved
setopt HIST_IGNORE_SPACE             # ignore commands starting with a space

# editor
autoload -U edit-command-line        # autoload external editor modules
zle -N edit-command-line             # allow editing with external editor
export EDITOR="vim"
_require -c nvim && () {
  alias vim=nvim
  export EDITOR="nvim"
  nvim_clear_cache() {
       for DIR in '.cache/nvim' '.local/state/nvim' '.local/share/nvim'; do
         TO_DELETE="${HOME}/${DIR}"
         echo -n "deleting ${TO_DELETE} ... " && rm -rf "${TO_DELETE}" && echo "DONE";
       done
  }
}
bindkey -e                           # emacs-style line editor
bindkey '\C-x\C-e' edit-command-line # open command line in editor with ctrl-x-e

# source custom scripts
CUSTOM_SCRIPTS=(
  "${HOME}/scripts/macos/macos_zsh.zsh"
)
for SCRIPT ($CUSTOM_SCRIPTS) _require -f "$SCRIPT" && . "$SCRIPT"

# eza (https://github.com/eza-community/eza)
LS='ls'
_require -c eza && LS='eza'
alias ls="${LS}"
alias ll="${LS} -l"    # long
alias la="${LS} -la"   # long, dotfiles

# fzf (https://github.com/junegunn/fzf)
_require -c fzf && source <(fzf --zsh)

# zoxide (https://github.com/ajeetdsouza/zoxide)
_require -c zoxide && eval "$(zoxide init zsh)"

# pure prompt (https://github.com/sindresorhus/pure)
_require -x "$BREW_PREFIX/opt/pure" && prompt pure


# zshrc

require() {
  case $1 in
    cmd)  command -v "$2" >/dev/null 2>&1 ;;
    file) [[ -f $2 ]] ;;
    dir)  [[ -d $2 ]] ;;
    exec) [[ -x $2 ]] ;;
    *)
      printf '%s %s\n' '[ERROR][zshrc]: unknown require type:' "$1" >&2
      return 1
      ;;
  esac || {
    printf '%s %s: %s\n' '[WARN][zshrc]: missing required' "$1" "$2" >&2
    return 1
  }
}

# deduplicate fpath entries automatically
typeset -U fpath

# homebrew site functions
require cmd brew \
  && BREW_PREFIX="$(brew --prefix 2>/dev/null)" \
  && () {
    local brew_sitefuncs="$BREW_PREFIX/share/zsh/site-functions"
    require dir "$brew_sitefuncs" && fpath+=("$brew_sitefuncs")
  }

# prompt init
autoload -U promptinit
promptinit

# lazy-loaded completion system
autoload -U compinit add-zsh-hook
_compinit_once() {
  compinit
  unfunction _compinit_once
}
add-zsh-hook precmd _compinit_once

# zsh syntax highlighting
ZSH_SYNTAX_HL_FILE="${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
require file "${ZSH_SYNTAX_HL_FILE}" && . "${ZSH_SYNTAX_HL_FILE}"

# zoxide (https://github.com/ajeetdsouza/zoxide)
require cmd zoxide && eval "$(zoxide init zsh)"

# pure prompt (https://github.com/sindresorhus/pure)
require exec "$BREW_PREFIX/opt/pure" && prompt pure


# zshrc

require() {
  { [ "$1" = cmd ]  && command -v "$2" >/dev/null 2>&1; } ||
  { [ "$1" = file ] && [ -f "$2" ]; } ||
  { [ "$1" = dir ]  && [ -d "$2" ]; } ||
  { [ "$1" = exec ] && [ -x "$2" ]; } ||
  printf '%s %s: %s\n' '[WARN][zshrc]: missing required' "$1" "$2" >&2
}

require cmd brew && BREW_PREFIX="$(brew --prefix 2>/dev/null)"

HOMEBREW_SITE_FUNCTIONS="$BREW_PREFIX/share/zsh/site-functions"
require dir "$HOMEBREW_SITE_FUNCTIONS" && fpath+=("$HOMEBREW_SITE_FUNCTIONS")

autoload -U promptinit compinit
promptinit; compinit

# zoxide (https://github.com/ajeetdsouza/zoxide)
require cmd zoxide && eval "$(zoxide init zsh)"

# pure prompt (https://github.com/sindresorhus/pure)
require exec "$BREW_PREFIX/opt/pure" && prompt pure


# zshrc

# required commands
for c in "brew"; do
  command -v "${c}" >/dev/null 2>&1 || echo "[WARN][zshrc]: missing required command: ${c}" >&2
done

BREW_PREFIX="$(brew --prefix)"

# required files
PREAMBLE_SCRIPT="${HOME}/scripts/posix/preamble.sh"
for f in "${PREAMBLE_SCRIPT}"; do
  [ -f "${f}" ] || echo "[WARN][zshrc]: missing required file: ${f}" >&2
done

# required directories
HOMEBREW_SITE_FUNCTIONS="${BREW_PREFIX}/share/zsh/site-functions"
for d in "${HOMEBREW_SITE_FUNCTIONS}"; do
  [ -d "${d}" ] || echo "[WARN][zshrc]: missing required directory: ${d}" >&2
done

# required executables
for x in "${BREW_PREFIX}/opt/pure" "${BREW_PREFIX}/opt/zoxide"; do
  [ -x "${x}" ] || echo "[WARN][zshrc]: missing required executable: ${x}" >&2
done

# import preamble script
. "${PREAMBLE_SCRIPT}"

# import site functions
fpath+=("${HOMEBREW_SITE_FUNCTIONS}")

# initialize zsh features
autoload -U promptinit && promptinit
autoload -Uz compinit && compinit

# set up zoxide (https://github.com/ajeetdsouza/zoxide)
eval "$(zoxide init zsh)"

# set up pure prompt (https://github.com/sindresorhus/pure)
prompt pure


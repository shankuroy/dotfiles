# zshrc

# Capture start time for zsh_healthcheck
zmodload zsh/datetime
export ZSH_START_TIME=$EPOCHREALTIME

# --- Environment & Paths ---
# Detect Homebrew
[[ -d /opt/homebrew ]] && export BREW_PREFIX="/opt/homebrew" || export BREW_PREFIX="/usr/local"

# Path setup (ensure unique entries)
typeset -U path fpath
# path=($HOME/bin $path)

# Add custom functions & Brew site-functions to fpath
fpath+=($HOME/.zsh/functions)
[[ -d "$BREW_PREFIX/share/zsh/site-functions" ]] && fpath+=("$BREW_PREFIX/share/zsh/site-functions")

# --- Options & History ---
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE EXTENDED_GLOB
export HISTFILE=${HOME}/.zsh_history
export HISTSIZE=100000
export SAVEHIST=$HISTSIZE

# --- Editor ---
(( $+commands[nvim] )) && export EDITOR="nvim" && alias vim="nvim"

# --- Completion System (Fast Cache) ---
autoload -U compinit
# Rebuild cache only once every 24h (#qN.m-1)
[[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.m-1) ]] && compinit -C || compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# --- Prompt ---
autoload -U promptinit; promptinit
prompt pure

# --- Tools & Aliases ---
(( $+commands[eza] )) && alias ls="eza" || alias ls="ls --color=auto"
alias la="ls -la"

(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[fzf] )) && source <(fzf --zsh)

# Autoloads (see ~/.zsh/functions)
autoload -Uz zsh_healthcheck nvim_clear_cache

# --- Bindings ---
bindkey -e
autoload -U edit-command-line; zle -N edit-command-line
bindkey '\C-x\C-e' edit-command-line

# --- External Scripts (Must be last) ---
[[ -f "${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -f "${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# Capture load time for zsh_healthcheck
export ZSH_LOAD_DURATION=$(( (EPOCHREALTIME - ZSH_START_TIME) * 1000 ))


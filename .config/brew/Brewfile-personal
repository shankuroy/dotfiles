# Brewfile-personal

# taps
tap "joshlin2201/itspaint", trusted: true

# formulae
brew "b2-tools"                         # Backblaze B2 CLI (https://www.backblaze.com/docs/cloud-storage-command-line-interface)
brew "cloudflared"                      # Cloudflare tunnel client (https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/)
brew "lume"                             # macOS VM CLI and framework (https://cua.ai/docs/lume/guide/getting-started/introduction)
brew "mas"                              # Mac App Store CLI (https://github.com/mas-cli/mas)

# casks
cask "affinity"                         # photo editing & vector drawing (https://www.affinity.studio/)
cask "ilok-license-manager"             # iLok plugin license manager (https://www.ilok.com/#!license-manager)
cask "joshlin2201/itspaint/itspaint"    # MS Paint for mac (https://github.com/joshlin2201/itspaint)
cask "localsend"                        # share files on local network (https://localsend.org/)
cask "logi-options+"                    # Logitech mouse config (https://www.logitech.com/en-au/software/logi-options-plus.html)
cask "reaper"                           # DAW (https://www.reaper.fm/)
cask "stremio"                          # video streaming (https://www.stremio.com/)

# mas
mas "GarageBand",       id: 682658836   # DAW (https://apps.apple.com/au/app/garageband/id682658836)
mas "SponsorBlock",     id: 1573461917  # Safari extension: YouTube sponsor blocker (https://apps.apple.com/au/app/sponsorblock-for-safari/id1573461917)
mas "Userscripts",      id: 1463298887  # Safari extension: custom user scripts (https://apps.apple.com/au/app/userscripts/id1463298887)
mas "Wipr 2",           id: 1662217862  # Safari extension: ad-blocker (https://apps.apple.com/au/app/wipr-2/id1662217862)
mas "Xcode",            id: 497799835   # MacOS/iOS IDE (https://apps.apple.com/au/app/xcode/id497799835)

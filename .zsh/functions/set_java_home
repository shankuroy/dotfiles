#!/usr/bin/env zsh

# Lists available Java SDKs and sets JAVA_HOME to the selection.

local selected_jdk
local search_query="$1"

# List all JDK directories from both user and system paths, pipe to fzf
selected_jdk=$(
  /usr/libexec/java_home -V 2>&1 \      # verbose list of available JDKs
    | grep '^\s' \                      # match line starting with whitespace
    | awk '{print $NF}' \               # print the last space-separated field
    | sort -rV \                        # reverse sort version numbers
    | fzf \
        --height='~-1' \                # adapt to input size up to terminal height minus 1
        --prompt='Select JDK > ' \
        --query="$search_query"         # pre-fill search query if provided
)

# If a selection was made (user didn't press Esc)
if [[ -n "$selected_jdk" ]]; then
  export JAVA_HOME="$selected_jdk"
  echo " JAVA_HOME set to: $JAVA_HOME"

  # Verify the active version
  java -version
else
  printf '❌ Selection canceled. '

  if [[ -n "$JAVA_HOME" ]]; then
    printf "JAVA_HOME remains as: $JAVA_HOME"
  else
    printf 'JAVA_HOME is not set.'
  fi

  printf "\n"
fi


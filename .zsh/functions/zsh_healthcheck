#!/usr/bin/env zsh

# Run 'zsh_healthcheck' manually to verify your setup

local missing=0
local num_errors=0

local red_cross='%F{red}✘%f'
local green_checkmark='%F{green}✔%f'

_info() {
  print -P "%F{blue}[INFO ]%f ${@}"
}

_error() {
  print -P "%B%F{red}[ERROR] ${@}%f%b" >&2
}

_replace_file_from_url() {
  local dest_file="$1"
  local src_url="$2"
  local tmp_file
  tmp_file="$(mktemp)"

  _info "\tdownloading %B${src_url}%b"
  if curl -fsSL -o "$tmp_file" "$src_url"; then
    if [[ -L "$dest_file" ]]; then
      rm -f "$dest_file"
    fi
    mv "$tmp_file" "$dest_file"
    _info "\twrote %B${dest_file}%b with content from %B${src_url}%b"
  else
    _error "download failed: $src_url"
    rm -f "$tmp_file"
    (( num_errors++ ))
  fi
}

_exists() {
  local ctype="$1"
  local target="$2"
  local download_target="$3"
  local found=0
  local is_file=0

  case "$ctype" in
    file|-f) is_file=1; [[ -f "$target" ]] && found=1 ;;
    dir|-d)  [[ -d "$target" ]] && found=1 ;;
    cmd|-c)  (( $+commands[$target] )) && found=1 ;;
    *) 
      _error "unknown check type '$ctype'"
      return 1 
      ;;
  esac

  if (( found )); then
    _info "${green_checkmark} $target"
    return 0
  else
    _error "${red_cross} missing $target"
    if [[ $is_file -ne 0 && -n "$download_target" ]]; then
      _replace_file_from_url "$target" "$download_target"
    fi
    return 1
  fi
}

print -P "%B--- zsh healthcheck ---%b"

_exists -c nvim
_exists -c eza
_exists -c fzf
_exists -c zoxide
_exists -c delta

_exists -f ~/.config/eza/theme.yml 'https://raw.githubusercontent.com/eza-community/eza-themes/main/themes/catppuccin-mocha.yml'
_exists -f "${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
_exists -f "${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

local elapsed=$(printf "%.2f" $ZSH_LOAD_DURATION)
print -P "%B%F{yellow}zsh load time: ${elapsed}ms%f%b"


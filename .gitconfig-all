# shared gitconfig
# not designed to be used by itself
# see scripts/bootstrap/bootstrap.sh

[user]
  useConfigOnly = true

[include]
  path = ~/.config/delta/theme.gitconfig

# delta (https://dandavison.github.io/delta/configuration.html)
[delta]
  features = catppuccin-mocha
  hyperlinks = true
  line-numbers = true
  navigate = true

[delta "side-by-side"]
  side-by-side = true

[diff]
  colorMoved = default

[alias]
  diff-side = "!git -c delta.features='side-by-side catppuccin-mocha' diff"

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[fetch]
  prune = true
  pruneTags = true

[merge]
  conflictStyle = zdiff3

[push]
  autoSetupRemote = true


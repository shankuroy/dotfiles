# shared gitconfig
# not designed to be used by itself
# see scripts/bootstrap/bootstrap.sh

[user]
  useConfigOnly = true

[alias]
  pp = pull --prune
  unstage = restore --staged --
  l = !lazygit

# delta (https://dandavison.github.io/delta/configuration.html)
[core]
  pager = delta

[include]
  path = ~/.local/share/nvim/site/pack/core/opt/tokyonight.nvim/extras/delta/tokyonight_moon.gitconfig

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictStyle = zdiff3


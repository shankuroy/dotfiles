# shared gitconfig
# not designed to be used by itself
# see scripts/bootstrap/bootstrap.sh

[user]
  useConfigOnly = true

[include]
  path = ~/.local/share/nvim/site/pack/core/opt/tokyonight.nvim/extras/delta/tokyonight_night.gitconfig

# delta (https://dandavison.github.io/delta/configuration.html)
[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[fetch]
  prune = true
  pruneTags = true

[merge]
  conflictStyle = zdiff3

[push]
  autoSetupRemote = true


#Brewfile-core
# settings and packages to include in all systems

# Install casks to a separate folder
cask_args appdir: "/Applications/Homebrew"

# bootstrap packages
brew "stow" # dotfiles/symlink manager
brew "mas" # Mac App Store CLI

# formulae
brew "bat" # cat(1) with syntax highlighting. https://github.com/sharkdp/bat
brew "neovim", args: ["HEAD"] # neovim text editor, nightly until 0.12 is stable
brew "pure" # zsh prompt
brew "ripgrep" # faster grep
brew "zoxide" # smarter cd; jump to directories
brew "zsh-syntax-highlighting" # <-- it's in the name, duh

# casks
cask "ghostty" # terminal emulator

# mas
mas "2FAS - Two Factor Authentication", id: 6443941139 # 2FA manager
mas "Bitwarden", id: 1352778147 # password manager

